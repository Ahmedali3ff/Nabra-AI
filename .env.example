# ══════════════════════════════════════════════════════════════════════
#  Nabra AI نَبْرة — Environment Variables
#  Built on VoiceForge (MIT License) by itzzavdhesh
#  https://github.com/itzzavdhesh/VoiceForge
#
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────
# Set to your deployed frontend URL in production.
# Example: CLIENT_URL=https://your-voxena-app.vercel.app
CLIENT_URL=http://localhost:5173

# ── Authentication ────────────────────────────────────────────────────
# Long random string used for JWT signing. Required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required in production — prevents speech token invalidation on restart.
STREAM_SECRET=

# ── Voice Engine (Chatterbox TTS via Hugging Face Gradio) ─────────────
# The Gradio space for Chatterbox Multilingual TTS.
# Leave blank to use the default public space (ResembleAI/Chatterbox-Multilingual-TTS).
GRADIO_SPACE=

# ── Mock / Offline Mode ───────────────────────────────────────────────
# Set to "true" to skip all real Chatterbox / TTS network calls.
# Useful for local development and CI without internet access.
# Has NO effect when NODE_ENV=production.
MOCK_CHATTERBOX=true
VITE_MOCK_MODE=true

# ── Frontend (Vite build-time variables, must start with VITE_) ───────
# The public URL of the deployed backend.
# In development with Vite proxy this can be left blank.
# In production set to your backend URL, e.g.:
#   VITE_API_BASE_URL=https://voxena-backend.onrender.com
VITE_API_BASE_URL=
